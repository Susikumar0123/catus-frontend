{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/local/",
      "destination": "/api/local-discovery?localPath="
    },
    {
      "source": "/local",
      "destination": "/api/local-discovery?localPath="
    },
    {
      "source": "/local/:localPath*",
      "destination": "/api/local-discovery?localPath=:localPath*"
    },
    {
      "source": "/:state(.*districtStateSlug.*)/:district(.*districtSlug.*)",
      "destination": "/api/invalid-seo-url"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/services",
      "destination": "/services.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://catus-backend-d2js.onrender.com/api/sitemap.xml"
    },
    {
      "source": "/sitemap-:page.xml",
      "destination": "https://catus-backend-d2js.onrender.com/api/sitemap/:page"
    },
    {
      "source": "/sitemaps/:division/:page.xml",
      "destination": "https://catus-backend-d2js.onrender.com/api/sitemaps/:division/:page.xml"
    },
    {
      "source": "/:state([a-z0-9-]+)/:district([a-z0-9-]+)/:location([a-z0-9-]+)/:serviceId(\\d{1,})",
      "destination": "https://catus-backend-d2js.onrender.com/api/seo-redirect/:state/:district/:location/:serviceId"
    },
    {
      "source": "/:state([a-z0-9-]+)/:district([a-z0-9-]+)",
      "destination": "/district.html?state=:state&district=:district"
    },
    {
      "source": "/:state([a-z0-9-]+)/:district([a-z0-9-]+)/location/:location([a-z0-9-]+)",
      "destination": "/location.html?state=:state&district=:district&location=:location"
    },
    {
      "source": "/:state([a-z0-9-]+)/:district([a-z0-9-]+)/:service([a-z0-9-]+)",
      "destination": "/api/seo-product?state=:state&district=:district&location=:district&service=:service&clean=1"
    },
    {
      "source": "/:state([a-z0-9-]+)/:district([a-z0-9-]+)/:location([a-z0-9-]+)/:service([a-z0-9-]+)",
      "destination": "/api/seo-product?state=:state&district=:district&location=:location&service=:service"
    }
  ],
  "redirects": [
    {
      "source": "/shop-product.html",
      "destination": "/store-product.html",
      "permanent": false
    },
    {
      "source": "/shop-checkout.html",
      "destination": "/store-checkout.html",
      "permanent": false
    },
    {
      "source": "/cerood-orders.html",
      "destination": "/store-orders.html",
      "permanent": false
    },
    {
      "source": "/shop-after-sales.html",
      "destination": "/store-after-sales.html",
      "permanent": false
    },
    {
      "source": "/cerood-cart.html",
      "destination": "/store-checkout.html?mode=cart",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/home-services.html",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/home-services.html",
      "permanent": false
    },
    {
      "source": "/tamil-nadu/chennai/chennai/:service([a-z0-9-]+)",
      "destination": "/tamil-nadu/chennai/:service",
      "permanent": true
    },
    {
      "source": "/renewed-product.html",
      "destination": "/shop.html",
      "permanent": false
    },
    {
      "source": "/clothing-checkout.html",
      "destination": "/shop.html",
      "permanent": false
    },
    {
      "source": "/renewed-admin.html",
      "destination": "/seller-dashboard-test/admin.html",
      "permanent": false
    },
    {
      "source": "/cosmetics-dashboard.html",
      "destination": "/seller-dashboard-test/connected.html",
      "permanent": false
    },
    {
      "source": "/cosmetics-checkout.html",
      "destination": "/shop.html",
      "permanent": false
    },
    {
      "source": "/clothing-admin.html",
      "destination": "/seller-dashboard-test/admin.html",
      "permanent": false
    },
    {
      "source": "/renewed-dashboard.html",
      "destination": "/seller-dashboard-test/connected.html",
      "permanent": false
    },
    {
      "source": "/clothing.html",
      "destination": "/shop.html",
      "permanent": false
    },
    {
      "source": "/clothing-product.html",
      "destination": "/shop.html",
      "permanent": false
    },
    {
      "source": "/cosmetics.html",
      "destination": "/shop.html",
      "permanent": false
    },
    {
      "source": "/clothing-dashboard.html",
      "destination": "/seller-dashboard-test/connected.html",
      "permanent": false
    },
    {
      "source": "/renewed-admin-login.html",
      "destination": "/seller-dashboard-test/admin.html",
      "permanent": false
    },
    {
      "source": "/renewed-checkout.html",
      "destination": "/shop.html",
      "permanent": false
    },
    {
      "source": "/renewed.html",
      "destination": "/shop.html",
      "permanent": false
    },
    {
      "source": "/cosmetics-product.html",
      "destination": "/shop.html",
      "permanent": false
    },
    {
      "source": "/cosmetics-admin.html",
      "destination": "/seller-dashboard-test/admin.html",
      "permanent": false
    },
    {
      "source": "/seller-dashboard.html",
      "destination": "/seller-dashboard-test/connected.html",
      "permanent": false
    },
    {
      "source": "/seller-login.html",
      "destination": "/seller-dashboard-test/connected.html",
      "permanent": false
    },
    {
      "source": "/seller-register.html",
      "destination": "/seller-join.html",
      "permanent": false
    },
    {
      "source": "/shop-dashboard.html",
      "destination": "/seller-dashboard-test/connected.html",
      "permanent": false
    }
  ]
}
