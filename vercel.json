{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://catus-backend-d2js.onrender.com/api/sitemap.xml"
    },
    {
      "source": "/sitemap-:page.xml",
      "destination": "https://catus-backend-d2js.onrender.com/api/sitemap/:page"
    },
    {
      "source": "/:state/:district/:location/:serviceId(\\d{1,})",
      "destination": "https://catus-backend-d2js.onrender.com/api/seo-redirect/:state/:district/:location/:serviceId"
    },
    {
      "source": "/:state/:district/:service",
      "destination": "/api/seo-product?state=:state&district=:district&location=:district&service=:service&clean=1"
    },
    {
      "source": "/:state/:district/:location/:service",
      "destination": "/api/seo-product?state=:state&district=:district&location=:location&service=:service"
    }
  ]
}